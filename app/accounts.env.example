# Accounts build settings (template). Copy to app/.env.accounts.local (git-ignored) and fill in, then:
#   npm run dev:accounts    or    npm run build:accounts
# Both values are PUBLIC by design (they end up in the browser). Access is enforced by the database.
# NEVER put a secret / service-role key here: every VITE_ variable is shipped to every visitor.
# Local development: the values come from `cd ../backend && npx supabase status -o env`
#   (API_URL and PUBLISHABLE_KEY).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
