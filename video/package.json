{
  "name": "pmh-anc-learn-video",
  "version": "1.0.0",
  "description": "Remotion lesson videos for PMH Smart ANC Learn",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@fontsource/sarabun": "^5.3.0",
    "@remotion/cli": "4.0.541",
    "@remotion/fonts": "4.0.541",
    "@remotion/media": "4.0.541",
    "@remotion/transitions": "4.0.541",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.541",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc --resolveJsonModule",
    "narrate": "node --env-file-if-exists=.env.local scripts/narrate.mjs",
    "render": "sh -c 'remotion render $0 out/$0.mp4 --crf=26 && remotion render $0-captioned out/$0-captioned.mp4 --crf=26'",
    "publish-to-app": "node scripts/publish.mjs",
    "video": "sh -c 'node --env-file-if-exists=.env.local scripts/narrate.mjs $0 && npm run render $0 && node scripts/publish.mjs $0'",
    "smoke": "remotion render SmokeTest out/smoke-test.mp4",
    "voice-samples": "node --env-file-if-exists=.env.local scripts/voice-samples.mjs",
    "batch": "node scripts/batch.mjs",
    "check-scripts": "node scripts/check-script.mjs"
  },
  "allowScripts": {
    "esbuild": false
  }
}
