# Copy this file to video/.env.local and fill in only the providers you use.
# .env.local is git-ignored. Never put keys in source code, scripts or JSON.
#
# ElevenLabs: https://elevenlabs.io/app/settings/api-keys
#   create a key restricted to "Text to Speech"
ELEVENLABS_API_KEY=
#
# Google Cloud Text-to-Speech (Chirp 3 HD). Billing must be enabled on the project
# (first 1M Chirp 3 HD characters per month are free, then US$30 per 1M).
#   Preferred: install the gcloud CLI, run `gcloud auth application-default login`,
#   enable the Text-to-Speech API on your project, and set:
GOOGLE_CLOUD_PROJECT=
#   Alternative: an API key restricted to "Cloud Text-to-Speech API"
GOOGLE_TTS_API_KEY=
#
# BOTNOI Voice: https://voice.botnoi.ai  (account > API token)
BOTNOI_TOKEN=
