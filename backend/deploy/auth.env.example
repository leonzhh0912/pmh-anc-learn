# Settings for the self-hosted Supabase "auth" service (docker-compose.yml, auth -> environment).
# PMH setup (2026-11-11): staff-issued logins only. Staff/admins create every account in the app, so
# nobody can sign up publicly and no SMS or email sender is needed.
# After editing: sh run.sh recreate auth
GOTRUE_SITE_URL=https://phimai-hospital.github.io
GOTRUE_URI_ALLOW_LIST=https://phimai-hospital.github.io
# no public sign-up: accounts are created by staff (patients) and administrators (staff)
GOTRUE_DISABLE_SIGNUP=true
# email + password sign-in (patient IDs use internal, undeliverable addresses; nothing is ever emailed)
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_PASSWORD_MIN_LENGTH=8
# no SMS
GOTRUE_EXTERNAL_PHONE_ENABLED=false
GOTRUE_HOOK_SEND_SMS_ENABLED=false
# staff/admin second factor (authenticator app, free)
GOTRUE_MFA_TOTP_ENROLL_ENABLED=true
GOTRUE_MFA_TOTP_VERIFY_ENABLED=true
# slow down password guessing (per IP)
GOTRUE_RATE_LIMIT_TOKEN_REFRESH=150

# --- Only if PMH later pays for SMS codes (see docs/THAI-CLOUD-SETUP.md, appendix) ---
# GOTRUE_DISABLE_SIGNUP=false
# GOTRUE_EXTERNAL_PHONE_ENABLED=true
# GOTRUE_SMS_AUTOCONFIRM=false
# GOTRUE_SMS_OTP_EXP=600
# GOTRUE_SMS_OTP_LENGTH=6
# GOTRUE_SMS_MAX_FREQUENCY=60s
# GOTRUE_RATE_LIMIT_SMS_SENT=100
# GOTRUE_HOOK_SEND_SMS_ENABLED=true
# GOTRUE_HOOK_SEND_SMS_URI=https://api.example.go.th/functions/v1/send-sms
# GOTRUE_HOOK_SEND_SMS_SECRETS=${SEND_SMS_HOOK_SECRET}
