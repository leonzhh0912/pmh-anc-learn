# Settings for the self-hosted Supabase "auth" service (docker-compose.yml, auth -> environment).
# Values here are NOT secrets except where marked; secrets go only into the server's .env file.
# After editing: sh run.sh recreate auth
GOTRUE_SITE_URL=https://phimai-hospital.github.io
GOTRUE_URI_ALLOW_LIST=https://phimai-hospital.github.io
GOTRUE_DISABLE_SIGNUP=false
# phone (SMS) sign-in: the main way in
GOTRUE_EXTERNAL_PHONE_ENABLED=true
GOTRUE_SMS_AUTOCONFIRM=false
GOTRUE_SMS_OTP_EXP=600            # 10 minutes (default is only 60 seconds)
GOTRUE_SMS_OTP_LENGTH=6
GOTRUE_SMS_MAX_FREQUENCY=60s      # resend cooldown
GOTRUE_RATE_LIMIT_SMS_SENT=100    # whole-system cap: protects the SMS budget
# send codes through our Edge Function (ThaiBulkSMS); must be https
GOTRUE_HOOK_SEND_SMS_ENABLED=true
GOTRUE_HOOK_SEND_SMS_URI=https://api.example.go.th/functions/v1/send-sms
GOTRUE_HOOK_SEND_SMS_SECRETS=${SEND_SMS_HOOK_SECRET}   # SECRET, from .env
# email sign-in (fallback): codes, not links
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_MAILER_AUTOCONFIRM=false
GOTRUE_MAILER_OTP_EXP=600
GOTRUE_MAILER_OTP_LENGTH=6
# staff/admin second factor (authenticator app)
GOTRUE_MFA_TOTP_ENROLL_ENABLED=true
GOTRUE_MFA_TOTP_VERIFY_ENABLED=true
