# Caddy: the HTTPS front door of the ANC server (automatic free Let's Encrypt certificate).
# Replace ancapi.example.go.th with the real name (DNS -> hospital public IP; ports 80 + 443 forwarded here).
ancapi.example.go.th {
	encode gzip
	# Only the parts the app uses are reachable from outside: sign-in, data API, functions.
	@api path /auth/v1/* /rest/v1/* /functions/v1/*
	handle @api {
		reverse_proxy 127.0.0.1:8000
	}
	# Everything else (including the Supabase dashboard) is not served to the internet.
	handle {
		respond "Not found" 404
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
# The dashboard (Studio) is reached only from an IT computer through an SSH tunnel:
#   ssh -L 8000:127.0.0.1:8000 ubuntu@<server internal IP>     then open http://localhost:8000 (dashboard login)
